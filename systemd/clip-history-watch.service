[Unit]
Description=clip-history clipboard watcher
# O watcher escuta o daemon do GPaste via D-Bus (org.gnome.GPaste); ele é
# D-Bus-activatable, mas pedimos a ordem explicitamente para evitar perder
# cópias feitas nos primeiros segundos da sessão.
After=graphical-session.target org.gnome.GPaste.service
Wants=org.gnome.GPaste.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/clip-history watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
